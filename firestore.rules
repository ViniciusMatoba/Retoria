rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isProfessional(profId) {
      return isOwner(profId);
    }

    // ─── Global account ───────────────────────────────────────────────────────
    match /accounts/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'accountTypes', 'createdAt', 'updatedAt'
           ]);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'accountTypes', 'updatedAt']);
    }

    // ─── Customer accounts ────────────────────────────────────────────────────
    match /customerAccounts/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'email', 'phone', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120;

      match /bookings/{bookingId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ─── Professionals ────────────────────────────────────────────────────────
    // Leitura: apenas usuários autenticados — visitantes anônimos usam /api/p/[slug] (DTO filtrado).
    // SEC-004: impede exposição de campos privados (email, plan, status) via client SDK.
    match /professionals/{profId} {
      allow read: if isAuth();

      // Criação: apenas campos de perfil — campos de licença/plano são imutáveis pelo cliente
      allow create: if isProfessional(profId)
        && !request.resource.data.keys().hasAny([
             'professionalStatus', 'plan', 'trialStartedAt', 'trialEndsAt',
             'licenseStatus', 'currentPeriodEnd', 'maxMembers'
           ]);

      // Atualização: bloqueia campos sensíveis de licença/status
      allow update: if isProfessional(profId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'professionalStatus', 'plan', 'trialStartedAt', 'trialEndsAt',
             'licenseStatus', 'currentPeriodEnd', 'maxMembers',
             'id', 'userId', 'createdAt'
           ]);

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isProfessional(profId);
      }

      match /availableSlots/{slotId} {
        allow read: if true;
        allow write: if isProfessional(profId);
      }

      // Índice privado: mapeamento leadId → slotIds. Sem bookingId nos slots públicos.
      // SEC-005: impede exposição de identificadores internos via slots públicos.
      match /slotBookings/{leadId} {
        allow read: if isProfessional(profId);
        allow write: if false; // apenas Admin SDK
      }

      match /leads/{leadId} {
        allow read, write: if isProfessional(profId);
      }

      match /customers/{customerUid} {
        allow read: if isProfessional(profId);
        allow write: if false;
      }

      match /usage/{period} {
        allow read: if isProfessional(profId);
        allow write: if false;
      }

      match /integrations/{integrationId} {
        allow read: if isProfessional(profId);
        allow write: if false;
      }
    }

    // ─── Licenças — Admin SDK only ────────────────────────────────────────────
    // Nenhum cliente pode criar, ler ou alterar licenças diretamente.
    // Toda operação passa pelo Admin SDK no servidor.
    match /licenses/{uid} {
      allow read, write: if false;
    }

    // ─── Tokens de ativação — Admin SDK only ─────────────────────────────────
    // Tokens são sensíveis: nunca expostos ao cliente diretamente.
    match /licenseTokens/{tokenId} {
      allow read, write: if false;
    }

    // ─── Convites de equipe — Admin SDK only ─────────────────────────────────
    // Leitura/validação de convite feita pelo servidor via Admin SDK.
    match /teamInvites/{tokenId} {
      allow read, write: if false;
    }

    // ─── Solicitações de acesso — escrita pública, leitura Admin SDK only ────
    // Qualquer visitante pode criar uma solicitação (formulário da /planos).
    // Leitura e atualização apenas pelo Admin SDK (API protegida por Bearer token).
    match /accessRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'nome', 'email', 'plano', 'status', 'createdAt'
                       ])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 1
                    && request.resource.data.nome.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.status == "pending"
                    && request.resource.data.plano in ['individual', 'professional', 'enterprise'];
      allow read, update, delete: if false;
    }
  }
}
